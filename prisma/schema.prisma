// Fase 0 — Fundação (ESPECIFICACAO-SISTEMA-FINANCEIRO.md §22)
// Modela apenas o necessário para o critério de aceite da Fase 0:
// login, papéis, RLS por workspace, e taxonomia completa carregada por seed.
// entry/entry_group/goal/asset/debt/budget entram nas Conversas 2 e 3.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidade e acesso (§19)
// ---------------------------------------------------------------------------

/// Papel global de plataforma (Arquitetura de Identidade/Planos, Fase 2 —
/// substitui `isPlatformAdmin` como fonte de verdade daqui pra frente, mas o
/// booleano antigo é mantido como legado por enquanto — ver seção 20 do
/// ARQUITETURA-IDENTIDADE-PLANOS.md, "nunca remover dado, sempre aditivo
/// primeiro". Nasce com só 2 valores de propósito; cresce sem precisar
/// migrar quem já tem NONE/PLATFORM_ADMIN quando um 3º valor for necessário.
enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

/// Espelha auth.users (Supabase Auth). A linha nasce por trigger no signup
/// (ver prisma/sql/001_auth_and_rls.sql) — o FK para auth.users é criado ali,
/// não aqui, porque auth.users não é uma tabela gerenciada pelo Prisma.
model Profile {
  id              String   @id @db.Uuid
  fullName        String?  @map("full_name")
  /// [LEGADO] Papel global (§19.1) — não é papel de workspace. Mantido em
  /// paralelo a `platformRole` durante a migração (nunca mais escrito depois
  /// que o backfill sincronizar os dois; remover só numa limpeza futura).
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  /// Substitui `isPlatformAdmin` como fonte de verdade — ver comentário do enum.
  platformRole    PlatformRole @default(NONE) @map("platform_role")
  createdAt       DateTime     @default(now()) @map("created_at")

  /// Dados pessoais (2026-08-06) — todos opcionais de propósito, ninguém é
  /// obrigado a preencher; editável pela própria pessoa (`/minha-conta`) ou
  /// pelo admin em nome de qualquer um (`/admin/usuarios/:id`).
  phone               String?   @map("phone")
  cpf                 String?   @map("cpf")
  birthDate           DateTime? @map("birth_date") @db.Date
  addressCep          String?   @map("address_cep")
  addressStreet       String?   @map("address_street")
  addressNumber       String?   @map("address_number")
  addressComplement   String?   @map("address_complement")
  addressNeighborhood String?   @map("address_neighborhood")
  addressCity         String?   @map("address_city")
  addressState        String?   @map("address_state")

  memberships Membership[]
  accessLogs  AccessLog[]

  @@map("profiles")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships      Membership[]
  people           Person[]
  wallets          Wallet[]
  subcategories    Subcategory[]
  entryGroups      EntryGroup[]
  entries          Entry[]
  importBatches    ImportBatch[]
  exportLogs       ExportLog[]
  workspaceInvites WorkspaceInvite[]
  subscriptions    Subscription[]
  entitlements     Entitlement[]
  accessLogs       AccessLog[]
  notifications    Notification[]

  @@map("workspaces")
}

enum MembershipRole {
  TITULAR
  MEMBRO
  LEITURA
  /// Novo (Arquitetura de Identidade/Planos) — acesso de consultor a um
  /// workspace que não é o dele. "Consultor" não é um tipo de pessoa, é este
  /// valor de papel numa Membership específica; a mesma Profile pode ter
  /// TITULAR no workspace próprio e ADVISOR em N workspaces de clientes.
  /// Nada no código hoje cria/consome este valor ainda (só a coluna existe) —
  /// entra em uso na próxima etapa (backend/auth), não nesta (schema).
  ADVISOR
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Membership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  role        MembershipRole
  /// Revogar vira status, nunca DELETE — preserva histórico de "quem teve
  /// acesso, entre quando e quando" (relevante sobretudo pra ADVISOR/auditoria).
  status      MembershipStatus @default(ACTIVE)
  revokedAt   DateTime?        @map("revoked_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@map("memberships")
}

/// Convite pra um workspace existente (item pendente do §19.1). Sem envio de
/// e-mail próprio: gera um link com token que o TITULAR/admin compartilha
/// manualmente. [LIMITAÇÃO CONHECIDA] não existe seletor de workspace ainda
/// (§19.1 pendente) — se quem aceita já tem workspace próprio, o app continua
/// mostrando o primeiro (`memberships[0]`), não necessariamente este.
model WorkspaceInvite {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  email       String
  /// Só dígitos (com DDI). Opcional — usado só pra montar o link wa.me de
  /// compartilhamento, nunca envia nada sozinho (sem API do WhatsApp Business).
  phone       String?
  role        MembershipRole @default(MEMBRO)
  token       String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  acceptedAt  DateTime?      @map("accepted_at")
  /// Novo — hoje o convite nunca expirava. Nullable de propósito: convites já
  /// existentes ficam sem expiração (nunca invalidados retroativamente por
  /// uma migration); só convites novos passam a receber uma data.
  expiresAt   DateTime?      @map("expires_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

// ---------------------------------------------------------------------------
// Comercial (planos) e auditoria — ARQUITETURA-IDENTIDADE-PLANOS.md, Fase 2
// Etapa 1. Só schema/dados nesta etapa: nenhuma tela, Server Action ou rota
// ainda lê/escreve estas tabelas — entram em uso nas próximas etapas
// (backend/auth, depois frontend). Backfill do workspace existente (plano
// LEGACY_INTERNAL) roda na migration desta etapa, ver seção "Comercial" nela.
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// Catálogo do que é vendido — muda com frequência comercial (nome, preço),
/// nunca é lido em código de tela por nome (sempre por `Feature.code`, via
/// `PlanFeature`), pra renomear/reprecificar não exigir tocar em tela nenhuma.
model Plan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String          @unique
  name            String
  priceCents      Int             @map("price_cents")
  billingInterval BillingInterval @map("billing_interval")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Uma funcionalidade que pode ser liberada por plano (ex.: "modulo_mei",
/// "ia_assistente", "open_finance"). Código de tela sempre checa por `code`
/// via `hasFeature()`, nunca por nome/id de Plan.
model Feature {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String

  planFeatures PlanFeature[]
  entitlements Entitlement[]

  @@map("features")
}

/// O que cada Plan libera — join simples, sem coluna própria.
model PlanFeature {
  planId    String @map("plan_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  /// Sem cobrança externa — usado pelo plano de backfill (LEGACY_INTERNAL).
  NONE
  STRIPE
  ASAAS
}

/// Workspace × Plan ao longo do tempo. Cancelar vira `status=CANCELED`, nunca
/// DELETE (histórico de billing é dado, não lixo). Pode haver mais de uma
/// linha por workspace (histórico) — a aplicação decide qual é "a ativa" na
/// próxima etapa; nenhuma constraint de unicidade aqui de propósito ainda.
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus
  paymentProvider        PaymentProvider    @default(NONE) @map("payment_provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@map("subscriptions")
}

/// Override pontual de feature pra um workspace específico, além do que o
/// Plan já libera (ex.: cortesia de acesso antecipado sem mudar de plano
/// formalmente). Nunca subtrai o que o plano já dá, só soma.
model Entitlement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  featureId   String    @map("feature_id") @db.Uuid
  grantedBy   String?   @map("granted_by") @db.Uuid
  reason      String?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureId])
  @@map("entitlements")
}

/// Todo acesso de alguém que NÃO é dono do workspace (platformRole=
/// PLATFORM_ADMIN ou Membership.role=ADVISOR) — nunca acesso do próprio
/// OWNER/MEMBER/VIEWER ao seu workspace (seria ruído, não auditoria).
/// Granularidade por rota/página nesta fase, não por campo — ver
/// ARQUITETURA-IDENTIDADE-PLANOS.md seção 11. Escrito num único ponto
/// (funil de sessão), não espalhado pelas telas.
model AccessLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorProfileId String         @map("actor_profile_id") @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  /// O papel usado no momento do acesso (nem sempre coincide com o atual, se
  /// a Membership mudar depois — é um registro histórico, não uma referência viva).
  actorRole      MembershipRole @map("actor_role")
  action         String
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  actor     Profile   @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@map("access_logs")
}

enum NotificationVisibility {
  /// Visível a todo mundo do workspace, incluindo o cliente (OWNER/MEMBER).
  SHARED
  /// Só visível a quem acessa como ADVISOR ou PLATFORM_ADMIN — os "alertas
  /// internos" do consultor que o cliente não vê.
  ADVISOR_ONLY
}

model Notification {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  visibility     NotificationVisibility
  severity       String
  message        String
  /// Referência solta (sem FK) de propósito — o tipo de entidade relacionada
  /// ainda não está decidido (pode ser Entry, Goal futuro, etc.); formalizar
  /// quando o primeiro tipo de alerta real for implementado.
  relatedEntryId String?                @map("related_entry_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  resolvedAt     DateTime?              @map("resolved_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Taxonomia (§7) — global, editada só por administrador (§20).
// ---------------------------------------------------------------------------

/// As 4 naturezas continuam fixas no código — todo cálculo de /lib/finance
/// assume exatamente estas 4 (§20: "todo cálculo depende delas, fixas no
/// código"). Só o RÓTULO exibido é editável pelo admin, via NatureLabel.
enum EntryNature {
  RECEITA
  DESPESA
  INVESTIMENTO
  OUTRO
}

/// Rótulo de exibição de cada natureza — a única parte de "Tipo" que o
/// admin pode editar. A natureza em si (as 4 chaves) não muda.
model NatureLabel {
  code    EntryNature @id
  labelPt String      @map("label_pt")

  @@map("nature_labels")
}

model Category {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nature    EntryNature
  name      String
  slug      String
  sortOrder Int         @map("sort_order")
  /// true para as categorias do seed; formulário de categoria só existe para admin (§20)
  isSystem  Boolean     @default(true) @map("is_system")
  createdAt DateTime    @default(now()) @map("created_at")

  subcategories Subcategory[]
  entries       Entry[]

  @@unique([nature, slug])
  @@map("categories")
}

/// [ATUALIZADO A PEDIDO DO USUÁRIO] Subcategoria virou admin-only, igual
/// Categoria — a versão original do §20 previa edição pelo cliente, mas
/// isso mudou. workspaceId continua existindo no schema (nunca é mais
/// preenchido por um titular/membro agora, só por admin se quiser algo
/// específico de um workspace) para não travar essa opção no futuro.
model Subcategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// null = subcategoria do sistema (seed, visível a todos os workspaces)
  /// preenchido = criada por um titular/membro, visível só no seu workspace (§20)
  workspaceId String?  @map("workspace_id") @db.Uuid
  name        String
  slug        String
  isSystem    Boolean  @default(true) @map("is_system")
  /// §20 — excluir em uso é bloqueado; a ação é arquivar (some dos formulários, mantém histórico).
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([categoryId, workspaceId, slug])
  @@map("subcategories")
}

// ---------------------------------------------------------------------------
// Carteiras (§9) — wallet_kind é referência extensível, nunca enum (§6.2).
// ---------------------------------------------------------------------------

model WalletKind {
  code            String  @id
  labelPt         String  @map("label_pt")
  affectsNetWorth Boolean @map("affects_net_worth")
  isLiability     Boolean @map("is_liability")

  wallets Wallet[]

  @@map("wallet_kinds")
}

/// Sem seed próprio — carregada a partir dos nomes distintos em seed_carteiras.csv (§25).
model Institution {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  slug String @unique

  wallets Wallet[]

  @@map("institutions")
}

model Wallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  kindCode       String   @map("kind_code")
  institutionId  String?  @map("institution_id") @db.Uuid
  /// true só para "Patrimônio" — pseudo-conta que deve virar `asset` (§9, Fase 1+)
  isPseudoWallet Boolean  @default(false) @map("is_pseudo_wallet")
  legacyName     String?  @map("legacy_name")
  slug           String
  linkedWalletId String?  @map("linked_wallet_id") @db.Uuid
  goalPurpose    String?  @map("goal_purpose")
  isActive       Boolean  @default(true) @map("is_active")
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(14, 2)
  closingDay     Int?     @map("closing_day")
  dueDay         Int?     @map("due_day")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind         WalletKind   @relation(fields: [kindCode], references: [code])
  institution  Institution? @relation(fields: [institutionId], references: [id])
  linkedWallet Wallet?      @relation("WalletLink", fields: [linkedWalletId], references: [id])
  linkedFrom   Wallet[]     @relation("WalletLink")
  entries      Entry[]

  @@unique([workspaceId, slug])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Responsáveis (§2, §9) — por workspace.
// ---------------------------------------------------------------------------

model Person {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  slug        String
  isShared    Boolean  @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([workspaceId, slug])
  @@map("people")
}

// ---------------------------------------------------------------------------
// Referências de lançamento (§6.3, §8.5) — global, usadas a partir da
// Fase 1 quando `entry` existir, mas carregadas por seed já na Fase 0.
// ---------------------------------------------------------------------------

model Status {
  code            String  @id
  labelPt         String  @map("label_pt")
  countsAsSettled Boolean @map("counts_as_settled")

  entries Entry[]

  @@map("statuses")
}

model RecurrenceKind {
  code           String  @id
  legacyLabel    String? @map("legacy_label")
  intervalMonths Int     @map("interval_months")

  entries Entry[]

  @@map("recurrence_kinds")
}

// ---------------------------------------------------------------------------
// Lançamentos (§8) — Conversa 3.
// ---------------------------------------------------------------------------

/// §8.4 — um compromisso financeiro que atravessa meses (parcelas de um
/// financiamento, ocorrências de uma assinatura). group_id é atribuído
/// automaticamente na criação, nunca digitado.
model EntryGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@map("entry_groups")
}

/// §8.1 — a entidade central do sistema.
model Entry {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Preservado para uma eventual migração histórica futura — o importador
  /// atual (§18) não popula este campo, pois não há migração do legado (§18).
  legacyId    Int?    @map("legacy_id")
  workspaceId String  @map("workspace_id") @db.Uuid
  groupId     String? @map("group_id") @db.Uuid

  /// Compra — fato gerador.
  transactionDate DateTime  @map("transaction_date") @db.Date
  /// Vence — liquidação.
  dueDate         DateTime  @map("due_date") @db.Date
  /// [MELHORIA] data efetiva da liquidação.
  settledAt       DateTime? @map("settled_at") @db.Date

  walletId      String      @map("wallet_id") @db.Uuid
  nature        EntryNature
  categoryId    String      @map("category_id") @db.Uuid
  subcategoryId String?     @map("subcategory_id") @db.Uuid
  description   String
  responsibleId String      @map("responsible_id") @db.Uuid
  /// Com sinal — despesa negativa, receita positiva (§8.3).
  amount        Decimal     @db.Decimal(14, 2)

  recurrenceCode        String  @map("recurrence_code")
  installmentNumber     Int?    @map("installment_number")
  installmentTotal      Int?    @map("installment_total")
  /// §6.4 — substituem os marcadores Patrimônio/Previsão da recorrência da planilha.
  isPatrimonio          Boolean @default(false) @map("is_patrimonio")
  isProjecao            Boolean @default(false) @map("is_projecao")
  /// §6.4 — preserva o rótulo original da planilha para rastreabilidade.
  legacyRecurrenceLabel String? @map("legacy_recurrence_label")

  statusCode String @map("status_code")

  note String?  @map("note")
  /// Substitui a coluna "Organização" da planilha — array de tags livres (§8.1).
  tags String[] @default([])

  /// Quando preenchido, manda sobre a regra automática fixa×variável (§11.7).
  isFixedOverride Boolean? @map("is_fixed_override")

  /// Liga as duas linhas de uma transferência (§10 R5). Nulo para lançamentos normais.
  transferId String? @map("transfer_id") @db.Uuid

  /// Preenchido só quando o lançamento nasceu de uma importação de CSV (§18.1).
  importBatchId String? @map("import_batch_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       EntryGroup?    @relation(fields: [groupId], references: [id])
  wallet      Wallet         @relation(fields: [walletId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?   @relation(fields: [subcategoryId], references: [id])
  responsible Person         @relation(fields: [responsibleId], references: [id])
  recurrence  RecurrenceKind @relation(fields: [recurrenceCode], references: [code])
  status      Status         @relation(fields: [statusCode], references: [code])
  importBatch ImportBatch?   @relation(fields: [importBatchId], references: [id])

  @@index([workspaceId, dueDate])
  @@index([workspaceId, walletId])
  @@index([groupId])
  @@index([transferId])
  @@map("entries")
}

/// §18.1 — um lote importado. Revertível com 1 clique enquanto nenhum dos
/// lançamentos do lote tiver sido editado depois (checado em código:
/// updated_at ainda igual a created_at).
model ImportBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  originalFilename String    @map("original_filename")
  importedCount    Int       @map("imported_count")
  errorCount       Int       @map("error_count")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  revertedAt       DateTime? @map("reverted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@map("import_batches")
}

/// §18.2 — "exportação é a principal via de vazamento de dados financeiros":
/// registro enxuto de quem exportou o quê, não um sistema de auditoria genérico.
model ExportLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  format      String
  /// resumo legível dos filtros ativos no momento da exportação (período, carteira, etc.)
  filters     String?
  rowCount    Int      @map("row_count")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("export_logs")
}
