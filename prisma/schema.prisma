// Fase 0 — Fundação (ESPECIFICACAO-SISTEMA-FINANCEIRO.md §22)
// Modela apenas o necessário para o critério de aceite da Fase 0:
// login, papéis, RLS por workspace, e taxonomia completa carregada por seed.
// entry/entry_group/goal/asset/debt/budget entram nas Conversas 2 e 3.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidade e acesso (§19)
// ---------------------------------------------------------------------------

/// Papel global de plataforma (Arquitetura de Identidade/Planos, Fase 2 —
/// substitui `isPlatformAdmin` como fonte de verdade daqui pra frente, mas o
/// booleano antigo é mantido como legado por enquanto — ver seção 20 do
/// ARQUITETURA-IDENTIDADE-PLANOS.md, "nunca remover dado, sempre aditivo
/// primeiro". Nasce com só 2 valores de propósito; cresce sem precisar
/// migrar quem já tem NONE/PLATFORM_ADMIN quando um 3º valor for necessário.
enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

/// Espelha auth.users (Supabase Auth). A linha nasce por trigger no signup
/// (ver prisma/sql/001_auth_and_rls.sql) — o FK para auth.users é criado ali,
/// não aqui, porque auth.users não é uma tabela gerenciada pelo Prisma.
model Profile {
  id              String       @id @db.Uuid
  fullName        String?      @map("full_name")
  /// [LEGADO] Papel global (§19.1) — não é papel de workspace. Mantido em
  /// paralelo a `platformRole` durante a migração (nunca mais escrito depois
  /// que o backfill sincronizar os dois; remover só numa limpeza futura).
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  /// Substitui `isPlatformAdmin` como fonte de verdade — ver comentário do enum.
  platformRole    PlatformRole @default(NONE) @map("platform_role")
  createdAt       DateTime     @default(now()) @map("created_at")

  /// Dados pessoais (2026-08-06) — todos opcionais de propósito, ninguém é
  /// obrigado a preencher; editável pela própria pessoa (`/minha-conta`) ou
  /// pelo admin em nome de qualquer um (`/admin/usuarios/:id`).
  phone               String?   @map("phone")
  cpf                 String?   @map("cpf")
  birthDate           DateTime? @map("birth_date") @db.Date
  addressCep          String?   @map("address_cep")
  addressStreet       String?   @map("address_street")
  addressNumber       String?   @map("address_number")
  addressComplement   String?   @map("address_complement")
  addressNeighborhood String?   @map("address_neighborhood")
  addressCity         String?   @map("address_city")
  addressState        String?   @map("address_state")

  /// LGPD (2026-08-07) — quando a pessoa aceitou a Política de Privacidade no
  /// cadastro. Nullable de propósito: contas criadas antes deste campo existir
  /// não têm registro retroativo (nunca inventamos consentimento que não
  /// aconteceu) — só cadastros novos passam a exigir e gravar isso. Serve como
  /// prova do consentimento (LGPD Art. 8º §2º: o ônus da prova é do controlador).
  privacyPolicyAcceptedAt DateTime? @map("privacy_policy_accepted_at")

  memberships Membership[]
  accessLogs  AccessLog[]
  googleCalendarConnectionsCreated GoogleCalendarConnection[]

  @@map("profiles")
}

model Workspace {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  /// Código do cliente — sequencial, atribuído automaticamente na criação (via
  /// sequence do Postgres, inclusive quando o workspace nasce pelo trigger
  /// on_auth_user_created, não só via Prisma) e nunca reatribuído depois.
  /// Cada workspace representa uma única pessoa ou família (§9); o código
  /// ajuda a diferenciar clientes de nomes parecidos — ver `admin/usuarios` e
  /// o seletor de workspace (`app/(app)/layout.tsx`).
  clientCode Int      @unique @default(autoincrement()) @map("client_code")
  createdAt  DateTime @default(now()) @map("created_at")

  /// Bloqueio de acesso (admin-only, 2026-08-12) — alternativa a excluir a conta de um
  /// cliente (ex.: inadimplência): pausa reversível de TODO mundo que acessa este
  /// workspace (titular, membros, consultor), sem apagar nada. Desbloquear zera os 4
  /// campos — sem tabela de histórico separada, mesmo espírito leve de `Entitlement`.
  blockedAt     DateTime?             @map("blocked_at")
  blockedReason WorkspaceBlockReason? @map("blocked_reason")
  /// Só usado (e obrigatório) quando blockedReason = OUTRO — mensagem exata mostrada ao
  /// cliente bloqueado, escrita pelo próprio admin em `/admin/usuarios`.
  blockedDetail String?               @map("blocked_detail")
  blockedBy     String?               @map("blocked_by") @db.Uuid
  /// Autocadastro sem convite (2026-08-12) — quando preenchido, já disparou o e-mail de
  /// aviso pra todo admin da plataforma; evita reenviar a cada tentativa de login de quem
  /// ainda está `blockedReason = AGUARDANDO_APROVACAO`. Ver `lib/workspace/pending-approval.ts`.
  adminNotifiedAt DateTime? @map("admin_notified_at")

  memberships      Membership[]
  people           Person[]
  wallets          Wallet[]
  subcategories    Subcategory[]
  entryGroups      EntryGroup[]
  entries          Entry[]
  importBatches    ImportBatch[]
  exportLogs       ExportLog[]
  workspaceInvites WorkspaceInvite[]
  subscriptions    Subscription[]
  planGrants       PlanGrant[]
  healthSnapshots  HealthSnapshot[]
  automationRules  AutomationRule[]
  aiInteractions   AiInteraction[]
  diagnosticResponses DiagnosticResponse[]
  entitlements     Entitlement[]
  accessLogs       AccessLog[]
  notifications    Notification[]
  budgets          Budget[]
  assets           Asset[]
  goals            Goal[]
  googleCalendarConnection GoogleCalendarConnection?
  descriptionRules DescriptionRule[]
  investments      Investment[]
  incomeSources    IncomeSource[]
  insurancePolicies InsurancePolicy[]
  benefitEntitlements BenefitEntitlement[]
  balanceReconciliations BalanceReconciliation[]
  mcrfAssessments        McrfAssessment[]
  consultingEngagements  ConsultingEngagement[]
  shockEvents            ShockEvent[]
  deliverables           Deliverable[]

  @@map("workspaces")
}

/// Motivo do bloqueio de acesso (ver `Workspace.blockedReason`) — 4 motivos escolhidos
/// pelo admin (+ OUTRO com texto livre em `blockedDetail`) e um automático
/// (AGUARDANDO_APROVACAO, gravado pelo próprio trigger `handle_new_auth_user()` — ver
/// `prisma/sql/010_self_signup_requires_approval.sql` — quando alguém se cadastra sem
/// convite, 2026-08-12). Cada um tem uma mensagem correspondente mostrada ao cliente
/// bloqueado, ver `lib/workspace/block-reasons.ts`.
enum WorkspaceBlockReason {
  FATURA_EM_ABERTO
  SOLICITACAO_DO_CLIENTE
  VERIFICACAO_DE_SEGURANCA
  ORIENTACAO_DO_CONSULTOR
  /// Autocadastro sem convite — só o próprio trigger de signup grava este valor.
  AGUARDANDO_APROVACAO
  OUTRO
}

enum MembershipRole {
  TITULAR
  MEMBRO
  LEITURA
  /// Novo (Arquitetura de Identidade/Planos) — acesso de consultor a um
  /// workspace que não é o dele. "Consultor" não é um tipo de pessoa, é este
  /// valor de papel numa Membership específica; a mesma Profile pode ter
  /// TITULAR no workspace próprio e ADVISOR em N workspaces de clientes.
  /// Nada no código hoje cria/consome este valor ainda (só a coluna existe) —
  /// entra em uso na próxima etapa (backend/auth), não nesta (schema).
  ADVISOR
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Membership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  role        MembershipRole
  /// Revogar vira status, nunca DELETE — preserva histórico de "quem teve
  /// acesso, entre quando e quando" (relevante sobretudo pra ADVISOR/auditoria).
  status      MembershipStatus @default(ACTIVE)
  revokedAt   DateTime?        @map("revoked_at")
  /// Só tem efeito quando role = ADVISOR — ignorado nos demais papéis (2026-08-15,
  /// AVALIACAO-UNIDADE-FINANCEIRA-CONSULTORIA.md §4.5 / ARQUITETURA-METODO-PROSPECTAR.md
  /// §3.2). default(false): consultor nasce só com leitura, mesmo com Membership
  /// ACTIVE; TITULAR concede/revoga a qualquer momento (nunca o próprio consultor),
  /// sempre auditado em AccessLog (lib/workspace/advisor.ts).
  advisorCanWrite Boolean       @default(false) @map("advisor_can_write")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@map("memberships")
}

/// Convite pra um workspace existente (item pendente do §19.1). Sem envio de
/// e-mail próprio: gera um link com token que o TITULAR/admin compartilha
/// manualmente. [LIMITAÇÃO CONHECIDA] não existe seletor de workspace ainda
/// (§19.1 pendente) — se quem aceita já tem workspace próprio, o app continua
/// mostrando o primeiro (`memberships[0]`), não necessariamente este.
model WorkspaceInvite {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  email       String
  /// Só dígitos (com DDI). Opcional — usado só pra montar o link wa.me de
  /// compartilhamento, nunca envia nada sozinho (sem API do WhatsApp Business).
  phone       String?
  role        MembershipRole @default(MEMBRO)
  token       String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  acceptedAt  DateTime?      @map("accepted_at")
  /// Novo — hoje o convite nunca expirava. Nullable de propósito: convites já
  /// existentes ficam sem expiração (nunca invalidados retroativamente por
  /// uma migration); só convites novos passam a receber uma data.
  expiresAt   DateTime?      @map("expires_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

// ---------------------------------------------------------------------------
// Comercial (planos) e auditoria — ARQUITETURA-IDENTIDADE-PLANOS.md, Fase 2
// Etapa 1. Só schema/dados nesta etapa: nenhuma tela, Server Action ou rota
// ainda lê/escreve estas tabelas — entram em uso nas próximas etapas
// (backend/auth, depois frontend). Backfill do workspace existente (plano
// LEGACY_INTERNAL) roda na migration desta etapa, ver seção "Comercial" nela.
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// Catálogo do que é vendido — muda com frequência comercial (nome, preço),
/// nunca é lido em código de tela por nome (sempre por `Feature.code`, via
/// `PlanFeature`), pra renomear/reprecificar não exigir tocar em tela nenhuma.
model Plan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String          @unique
  name            String
  priceCents      Int             @map("price_cents")
  billingInterval BillingInterval @map("billing_interval")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  planFeatures  PlanFeature[]
  subscriptions Subscription[]
  planGrants    PlanGrant[]

  @@map("plans")
}

/// Uma funcionalidade que pode ser liberada por plano (ex.: "modulo_mei",
/// "ia_assistente", "open_finance"). Código de tela sempre checa por `code`
/// via `hasFeature()`, nunca por nome/id de Plan.
model Feature {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String
  /// ARQUITETURA-METODO-PROSPECTAR.md §3.1/5.2 (Etapa 3, 2026-08-15) — admin
  /// decide, por feature, se ela é liberada por nível de plano (padrão) ou
  /// por camada de método. Desde a Etapa 8 (2026-08-17), METODO é resolvido
  /// por `ConsultingEngagement` ativo. Editável em /admin/planos, sem deploy.
  gateKind FeatureGateKind @default(PLANO) @map("gate_kind")
  /// §13.8 (Etapa 8) — a qual fase do método esta feature pertence (0–9).
  /// Só usado por contratos de `modality = PROJETO`, que liberam **apenas a
  /// fase contratada** em vez da camada inteira. Nulo = não pertence a uma
  /// fase específica; nesse caso um contrato de projeto não a libera, porque
  /// ampliar escopo por omissão daria de graça o que não foi contratado.
  methodPhase Int? @map("method_phase")

  planFeatures PlanFeature[]
  entitlements Entitlement[]

  @@map("features")
}

enum FeatureGateKind {
  PLANO
  METODO
}

/// O que cada Plan libera — join simples, sem coluna própria.
model PlanFeature {
  planId    String @map("plan_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  /// Sem cobrança externa — usado pelo plano de backfill (LEGACY_INTERNAL).
  NONE
  STRIPE
  ASAAS
}

/// Workspace × Plan ao longo do tempo. Cancelar vira `status=CANCELED`, nunca
/// DELETE (histórico de billing é dado, não lixo). Pode haver mais de uma
/// linha por workspace (histórico) — a aplicação decide qual é "a ativa" na
/// próxima etapa; nenhuma constraint de unicidade aqui de propósito ainda.
model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus
  paymentProvider        PaymentProvider    @default(NONE) @map("payment_provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@map("subscriptions")
}

/// §4.6 da Metodologia PROSPECTA v5.0 (ARQUITETURA-METODO-PROSPECTAR.md §3/5.2,
/// Etapa 4, 2026-08-15) — camada 2 do modelo de direitos em três camadas:
/// elevação TEMPORÁRIA de nível decorrente de um contrato de consultoria (ex.:
/// Max incluído durante o planejamento). Nunca substitui a Subscription — só
/// soma no cálculo do nível efetivo (lib/billing/effective-level.ts). Garantia
/// central do documento de arquitetura: `Subscription` nunca é escrita por
/// causa de contratação/conclusão/cancelamento de consultoria, sempre um
/// PlanGrant com início e fim.
model PlanGrant {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  planId       String    @map("plan_id") @db.Uuid
  /// Nasceu como referência solta (Etapa 4), à espera de `ConsultingEngagement`
  /// existir. **Ganhou FK de verdade na Etapa 8**, como estava previsto. Nulo
  /// quando a concessão não vem de um contrato de consultoria (ex.: cortesia
  /// manual concedida pelo admin) — por isso `SetNull`, e não `Cascade`:
  /// encerrar um contrato não pode apagar o histórico de concessões que ele
  /// gerou.
  engagementId String?   @map("engagement_id") @db.Uuid
  reason       String
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime  @map("ends_at")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Preenchido quando revogada antes do fim natural — nunca DELETE (mesmo
  /// espírito de Membership.status/revokedAt).
  revokedAt    DateTime? @map("revoked_at")

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan       Plan                  @relation(fields: [planId], references: [id])
  engagement ConsultingEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([workspaceId, endsAt])
  @@map("plan_grants")
}

/// Override pontual de feature pra um workspace específico, além do que o
/// Plan já libera (ex.: cortesia de acesso antecipado sem mudar de plano
/// formalmente). Nunca subtrai o que o plano já dá, só soma.
model Entitlement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  featureId   String    @map("feature_id") @db.Uuid
  grantedBy   String?   @map("granted_by") @db.Uuid
  reason      String?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureId])
  @@map("entitlements")
}

/// Todo acesso de alguém que NÃO é dono do workspace (platformRole=
/// PLATFORM_ADMIN ou Membership.role=ADVISOR) — nunca acesso do próprio
/// OWNER/MEMBER/VIEWER ao seu workspace (seria ruído, não auditoria).
/// Granularidade por rota/página nesta fase, não por campo — ver
/// ARQUITETURA-IDENTIDADE-PLANOS.md seção 11. Escrito num único ponto
/// (funil de sessão), não espalhado pelas telas.
model AccessLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorProfileId String         @map("actor_profile_id") @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  /// O papel usado no momento do acesso (nem sempre coincide com o atual, se
  /// a Membership mudar depois — é um registro histórico, não uma referência viva).
  actorRole      MembershipRole @map("actor_role")
  action         String
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  actor     Profile   @relation(fields: [actorProfileId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@map("access_logs")
}

enum NotificationVisibility {
  /// Visível a todo mundo do workspace, incluindo o cliente (OWNER/MEMBER).
  SHARED
  /// Só visível a quem acessa como ADVISOR ou PLATFORM_ADMIN — os "alertas
  /// internos" do consultor que o cliente não vê.
  ADVISOR_ONLY
}

model Notification {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  visibility     NotificationVisibility
  severity       String
  message        String
  /// Referência solta (sem FK) de propósito — o tipo de entidade relacionada
  /// ainda não está decidido (pode ser Entry, Goal futuro, etc.); formalizar
  /// quando o primeiro tipo de alerta real for implementado.
  relatedEntryId String?                @map("related_entry_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  resolvedAt     DateTime?              @map("resolved_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Taxonomia (§7) — global, editada só por administrador (§20).
// ---------------------------------------------------------------------------

/// As 4 naturezas continuam fixas no código — todo cálculo de /lib/finance
/// assume exatamente estas 4 (§20: "todo cálculo depende delas, fixas no
/// código"). Só o RÓTULO exibido é editável pelo admin, via NatureLabel.
enum EntryNature {
  RECEITA
  DESPESA
  INVESTIMENTO
  OUTRO
}

/// Rótulo de exibição de cada natureza — a única parte de "Tipo" que o
/// admin pode editar. A natureza em si (as 4 chaves) não muda.
model NatureLabel {
  code    EntryNature @id
  labelPt String      @map("label_pt")

  @@map("nature_labels")
}

model Category {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nature    EntryNature
  name      String
  slug      String
  sortOrder Int         @map("sort_order")
  /// true para as categorias do seed; formulário de categoria só existe para admin (§20)
  isSystem  Boolean     @default(true) @map("is_system")
  createdAt DateTime    @default(now()) @map("created_at")

  subcategories    Subcategory[]
  entries          Entry[]
  budgets          Budget[]
  assets           Asset[]
  descriptionRules DescriptionRule[]
  incomeSources    IncomeSource[]

  @@unique([nature, slug])
  @@map("categories")
}

/// [ATUALIZADO A PEDIDO DO USUÁRIO] Subcategoria virou admin-only, igual
/// Categoria — a versão original do §20 previa edição pelo cliente, mas
/// isso mudou. workspaceId continua existindo no schema (nunca é mais
/// preenchido por um titular/membro agora, só por admin se quiser algo
/// específico de um workspace) para não travar essa opção no futuro.
model Subcategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// null = subcategoria do sistema (seed, visível a todos os workspaces)
  /// preenchido = criada por um titular/membro, visível só no seu workspace (§20)
  workspaceId String?  @map("workspace_id") @db.Uuid
  name        String
  slug        String
  isSystem    Boolean  @default(true) @map("is_system")
  /// §20 — excluir em uso é bloqueado; a ação é arquivar (some dos formulários, mantém histórico).
  isActive    Boolean  @default(true) @map("is_active")
  /// Método PROSPECTAR §13.3 (ARQUITETURA-METODO-PROSPECTAR.md §5.1, Etapa 1) —
  /// eixo independente de fixo×variável (isFixedOverride), usado pela Régua de
  /// Alocação. Só se aplica a subcategorias de DESPESA — nulo nas demais
  /// naturezas e em subcategorias de DESPESA ainda não classificadas (seed
  /// inicial em seeds/seed_macro_blocos.csv cobre as 285 existentes).
  macroBloco  MacroBloco? @map("macro_bloco")
  /// PROSPECTA-MCRF §11.1–11.3 (Etapa 9-A.3) — ver enum `Rigidez`. Eixo
  /// independente do `macroBloco`, e é ele que separa CEMA de CCM. Global e
  /// admin-only (decisão do usuário, 2026-08-16): editável em
  /// `/admin/metodologia`, nunca por workspace.
  rigidez     Rigidez?    @map("rigidez")
  createdAt   DateTime @default(now()) @map("created_at")

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries          Entry[]
  descriptionRules DescriptionRule[]

  @@unique([categoryId, workspaceId, slug])
  @@map("subcategories")
}

/// §11.2 da Metodologia PROSPECTA v5.0 — os 4 blocos da Régua de Alocação.
/// POUPANCA nunca é atribuído a uma Subcategory (poupar não é despesa neste
/// sistema — é aporte de INVESTIMENTO ou transferência pra caixinha); existe
/// no enum só porque Entry.macroBlocoOverride precisa do mesmo domínio de
/// valores para os casos raros de reclassificação manual.
enum MacroBloco {
  ESSENCIAL
  ESTILO_DE_VIDA
  OBRIGACAO
  POUPANCA
}

/// §11.1–11.3 da especificação PROSPECTA-MCRF — como a despesa se comporta
/// quando a renda aperta. Eixo **independente** do `MacroBloco`: aluguel e
/// supermercado são os dois ESSENCIAL (e corretamente), mas um não cede e o
/// outro comprime — e é essa diferença que separa o CEMA (custo essencial
/// normal) do CCM (custo durante a crise).
///
/// Regra aprovada pelo usuário em 2026-08-16:
/// - RIGIDA = contrato de valor fixo que se paga mesmo sem usar;
/// - AJUSTAVEL = essencial cujo consumo a pessoa controla;
/// - DISCRICIONARIA = pode ser suspensa (o `ESTILO_DE_VIDA` de hoje).
///
/// Exceção explícita do usuário: Energia, Água, Gás, Telefone e Internet ficam
/// como RIGIDA, apesar de tecnicamente serem consumo — a compressão real é
/// pequena e a escolha erra deliberadamente para reserva maior.
enum Rigidez {
  RIGIDA
  AJUSTAVEL
  DISCRICIONARIA
}

/// §13/§46 da especificação PROSPECTA-MCRF — natureza do choque financeiro.
enum ShockKind {
  PERDA_DE_RENDA
  REDUCAO_DE_RENDA
  DESPESA_INESPERADA
  INCAPACIDADE
  EMERGENCIA_FAMILIAR
  REPARO_ESSENCIAL
  OUTRO
}

/// §13, §45 e §46 — um choque financeiro que **de fato aconteceu** com esta
/// família.
///
/// Existe por três razões, nesta ordem de importância:
///
/// 1. **§34** — o piso de liquidez imediata deve considerar o histórico de
///    grandes despesas da própria pessoa. Um cenário simulado é hipótese; um
///    evento registrado é fato, e fato pesa mais.
/// 2. **§45** — quando a reserva é usada, o sistema precisa saber: registrar o
///    evento, o valor, a categoria, se houve indenização, e gerar um plano de
///    recomposição. "A reserva deve ser tratada como sistema vivo."
/// 3. **§46** — aprendizado com eventos reais. Com a ressalva que o próprio §46
///    faz e que este schema respeita: **"não implementar aprendizado opaco;
///    toda inferência relevante deverá ser identificável"**. Por isso cada
///    campo é explícito e nenhum modelo estatístico escondido consome esta
///    tabela — quem lê a tela consegue apontar qual evento mudou qual número.
model ShockEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Quem foi afetado. Nulo quando atingiu a família toda (ex.: reparo na casa).
  personId    String?   @map("person_id") @db.Uuid
  kind        ShockKind
  description String
  occurredAt  DateTime  @map("occurred_at") @db.Date

  /// §46 — o impacto, separado em suas duas naturezas. Uma demissão é perda de
  /// renda; um reparo é despesa extraordinária; uma incapacidade costuma ser
  /// os dois, e somá-los num campo só perderia essa informação.
  extraordinaryExpense Decimal? @map("extraordinary_expense") @db.Decimal(14, 2)
  incomeLossMonthly    Decimal? @map("income_loss_monthly") @db.Decimal(14, 2)
  durationMonths       Int?     @map("duration_months")

  /// §13/§26 — o que o seguro de fato resolveu. `daysUntilReimbursement` é o
  /// dado mais valioso da tabela: ele calibra, com evidência real, o
  /// `payoutDelayDays` que hoje é declarado na apólice.
  hadInsurance           Boolean? @map("had_insurance")
  reimbursedAmount       Decimal? @map("reimbursed_amount") @db.Decimal(14, 2)
  paidByUserAmount       Decimal? @map("paid_by_user_amount") @db.Decimal(14, 2)
  daysUntilReimbursement Int?     @map("days_until_reimbursement")

  /// §45 — protocolo de recomposição. `recomposedAt` nulo com
  /// `reserveUsedAmount` preenchido significa reserva ainda por repor.
  reserveUsedAmount Decimal?  @map("reserve_used_amount") @db.Decimal(14, 2)
  recomposedAt      DateTime? @map("recomposed_at") @db.Date

  notes     String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@map("shock_events")
}

// ---------------------------------------------------------------------------
// Camada de Método (Etapa 8) — a terceira camada do modelo de direitos (§4.6).
// Subscription = o que foi contratado; PlanGrant = elevação temporária;
// ConsultingEngagement = o que só existe com consultor ativo.
// ---------------------------------------------------------------------------

enum EngagementModality {
  DIAGNOSTICO
  PLANEJAMENTO
  PROJETO
  ACOMPANHAMENTO
}

enum EngagementTrack {
  ESSENCIAL
  COMPLETO
}

enum EngagementStatus {
  ATIVO
  CONCLUIDO
  CANCELADO
}

/// §13.7 — contrato de consultoria; a chave da camada de método.
///
/// Um workspace pode ter vários ao longo do tempo (histórico), mas **nunca mais
/// de um ATIVO por vez** — regra de aplicação, não de schema, mesmo padrão já
/// usado em `Subscription`. Encerrar é mudar `status`, nunca apagar: o
/// histórico de quem acompanhou quem, e quando, é a própria auditoria da
/// consultoria.
model ConsultingEngagement {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  modality    EngagementModality
  track       EngagementTrack?
  /// Só relevante para `modality = PROJETO` — qual fase do método este contrato
  /// libera (§13.8). Nulo nos demais casos, onde a camada inteira é liberada.
  projectPhase Int?              @map("project_phase")
  seatType    String             @map("seat_type")
  status      EngagementStatus   @default(ATIVO)
  startsAt    DateTime           @map("starts_at")
  endsAt      DateTime?          @map("ends_at")
  createdBy   String             @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planGrants   PlanGrant[]
  phases       MethodPhase[]
  deliverables Deliverable[]
  diagnosticResponses DiagnosticResponse[]

  @@index([workspaceId, status])
  @@map("consulting_engagements")
}

/// §7.2/§7.3 — os quatro resultados possíveis do ritual de passagem.
/// `AVANCO_CONDICIONAL` e `RETORNO_ASSISTIDO` exigem micrometa com prazo
/// (§7.1 Regra 3) — ver `GateCheck.followUpDueAt`.
enum GatePhaseStatus {
  EM_ANDAMENTO
  AVANCO_PLENO
  AVANCO_CONDICIONAL
  RETORNO_ASSISTIDO
}

/// §7 — fase atual e histórico dentro de um contrato. 0–8 mapeiam às fases do
/// método; 9 representa a Fase ∞ (Plano Integrado).
model MethodPhase {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagementId String          @map("engagement_id") @db.Uuid
  phaseNumber  Int             @map("phase_number")
  status       GatePhaseStatus @default(EM_ANDAMENTO)
  startedAt    DateTime        @map("started_at")
  endedAt      DateTime?       @map("ended_at")

  engagement ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  gateChecks GateCheck[]

  @@unique([engagementId, phaseNumber])
  @@map("method_phases")
}

/// §7.2 — avaliação de um gate ao fim de uma fase. Registra o ritual de
/// passagem (§7.3): critério, resultado, evidência, quem avaliou e quando.
///
/// Existe para que "o cliente avançou" nunca seja uma opinião não registrada.
model GateCheck {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phaseId     String          @map("phase_id") @db.Uuid
  criterion   String
  result      GatePhaseStatus
  evidence    String?
  evaluatedBy String          @map("evaluated_by") @db.Uuid
  evaluatedAt DateTime        @default(now()) @map("evaluated_at")
  /// Obrigatório em AVANCO_CONDICIONAL/RETORNO_ASSISTIDO — a micrometa de
  /// §7.1 Regra 3. Avançar com ressalva sem prazo é avançar sem ressalva.
  followUpDueAt DateTime?     @map("follow_up_due_at")

  phase MethodPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("gate_checks")
}

/// §12.1 — os dez artefatos codificados do Método PROSPECTAR.
enum DeliverableCode {
  PAN
  AFF
  RAP
  MEC
  MRP
  PLA
  PIP
  MFP
  PCP
  PFI
}

enum DeliverableStatus {
  RASCUNHO
  VALIDADO
  ASSINADO
}

/// §12.1 — um artefato entregue ao cliente dentro de um contrato.
///
/// **Versionado, nunca sobrescrito.** Cada validação de fase gera uma versão
/// nova (PFI v0 na Fase 1, v1 na Fase 2…) — mesmo espírito de `EntryAudit` e
/// de `McrfAssessment`. Um entregável é o registro do que foi dito ao cliente
/// numa data; reescrever o passado apagaria a própria prova do trabalho.
model Deliverable {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String            @map("workspace_id") @db.Uuid
  engagementId String            @map("engagement_id") @db.Uuid
  code         DeliverableCode
  version      Int
  status       DeliverableStatus @default(RASCUNHO)
  /// Conteúdo estruturado — o formato por código vive em
  /// `lib/method/deliverables/catalog.ts`. Json porque cada artefato tem suas
  /// seções e travar em colunas exigiria migration a cada refinamento.
  content      Json
  createdBy    String            @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  validatedAt  DateTime?         @map("validated_at")

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, code, version])
  @@index([workspaceId, code])
  @@map("deliverables")
}

/// §48 da especificação PROSPECTA-MCRF — a foto de um cálculo de reserva.
///
/// **Nunca sobrescreve cálculo histórico** (§48 é explícito). Cada avaliação é
/// uma linha nova, com a versão da metodologia que a produziu — sem isso, duas
/// fotos com regras diferentes pareceriam comparáveis, e a comparação ao longo
/// do tempo (que é o propósito do módulo) mentiria.
///
/// Mesmo espírito de `HealthSnapshot` (Etapa 5), mas com um campo a mais que
/// faz toda a diferença: `methodologyVersion`. O PSF aceitou quebra de
/// comparabilidade por decisão do usuário; aqui não dá — a reserva é um valor
/// em reais que a pessoa persegue por meses.
model McrfAssessment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  methodologyVersion String   @map("methodology_version")
  calculationDate    DateTime @default(now()) @map("calculation_date")
  /// Data-base do dado usado — distinta da data do cálculo: recalcular hoje
  /// com dado de ontem produz números diferentes de recalcular amanhã.
  dataReferenceDate  DateTime @map("data_reference_date") @db.Date

  cema             Decimal @map("cema") @db.Decimal(14, 2)
  ccm              Decimal @map("ccm") @db.Decimal(14, 2)
  /// A Proteção Recomendada (§37) — o número que a tela destaca.
  reserveTarget    Decimal @map("reserve_target") @db.Decimal(14, 2)
  /// §30 — o que a pessoa tem hoje, já ponderado pela elegibilidade.
  eligibleReserve  Decimal @map("eligible_reserve") @db.Decimal(14, 2)
  iprf             Int?

  /// Resultado de cada cenário e os fatores explicativos (§41/§53). Json porque
  /// a forma evolui junto com a metodologia, e travar em colunas obrigaria
  /// migration a cada refinamento de cenário.
  scenarios    Json
  mainDrivers  Json  @map("main_drivers")
  dataConfidence String @map("data_confidence")

  createdBy String?  @map("created_by") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, calculationDate])
  @@map("mcrf_assessments")
}

/// §52 — parâmetros da metodologia, centralizados e versionados. Existe porque
/// o usuário decidiu (2026-08-16) que estes números são **globais e editáveis
/// somente pelo administrador da plataforma**, valendo para todo o sistema:
/// dois clientes com o mesmo dado precisam receber a mesma recomendação, então
/// não pode ser configuração por workspace.
///
/// Sem tabela, o número viveria como constante em código e só mudaria com
/// deploy — o oposto do que foi pedido. `lib/method/mcrf/config.ts` continua
/// definindo o **padrão inicial e o fallback**; esta tabela é a sobreposição.
model MethodologyParameter {
  /// Chave estável, ex.: "ccm.reducao_ajustavel_pct". Nunca renomeada — o motor
  /// depende dela, e renomear silenciosamente faria o valor voltar ao padrão.
  key         String   @id
  value       Decimal  @db.Decimal(14, 4)
  label       String
  description String?
  /// Profile do admin que alterou por último — auditoria mínima, mesmo espírito
  /// de `HealthSnapshot.reviewedBy`.
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("methodology_parameters")
}

/// §13.4 da Metodologia PROSPECTA v5.0 (ARQUITETURA-METODO-PROSPECTAR.md §5.1,
/// Etapa 7) — para que serve cada peça do patrimônio. Eixo de ESTOQUE,
/// independente do `MacroBloco` (que é eixo de FLUXO) e do `InvestmentClass`
/// (que diz o que a coisa É, não para que serve): o mesmo CDB pode ser
/// PROTECAO numa família e CRESCIMENTO noutra. Sempre opcional — patrimônio
/// não classificado é estado explícito ("sem função"), nunca erro.
enum FuncaoPatrimonial {
  PROTECAO
  LIQUIDEZ_OPERACIONAL
  OBJETIVOS
  LONGEVIDADE
  CRESCIMENTO
  USO
  SUCESSAO
}

// ---------------------------------------------------------------------------
// Carteiras (§9) — wallet_kind é referência extensível, nunca enum (§6.2).
// ---------------------------------------------------------------------------

model WalletKind {
  code            String  @id
  labelPt         String  @map("label_pt")
  affectsNetWorth Boolean @map("affects_net_worth")
  isLiability     Boolean @map("is_liability")

  wallets Wallet[]

  @@map("wallet_kinds")
}

/// Sem seed próprio — carregada a partir dos nomes distintos em seed_carteiras.csv (§25).
model Institution {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  slug String @unique

  wallets Wallet[]

  @@map("institutions")
}

model Wallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  kindCode       String   @map("kind_code")
  institutionId  String?  @map("institution_id") @db.Uuid
  /// true só para "Patrimônio" — pseudo-conta que deve virar `asset` (§9, Fase 1+)
  isPseudoWallet Boolean  @default(false) @map("is_pseudo_wallet")
  legacyName     String?  @map("legacy_name")
  slug           String
  linkedWalletId String?  @map("linked_wallet_id") @db.Uuid
  goalPurpose    String?  @map("goal_purpose")
  isActive       Boolean  @default(true) @map("is_active")
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(14, 2)
  closingDay     Int?     @map("closing_day")
  dueDay         Int?     @map("due_day")
  /// AVALIACAO-UNIDADE-FINANCEIRA-CONSULTORIA.md §4.3 (ARQUITETURA-METODO-
  /// PROSPECTAR.md §5.1, Etapa 1) — titular econômico dentro da unidade
  /// financeira (Workspace), para Plano Família e preparação de Open Finance.
  /// Aponta pra Person (o "responsável" já existente), não Profile/login —
  /// titularidade de recurso é conceito de negócio, não de autenticação.
  /// Nulo = comum/compartilhado entre os membros da família (comportamento
  /// atual de toda carteira existente).
  ownerPersonId  String?  @map("owner_person_id") @db.Uuid
  /// Etapa 7 (2026-08-15) — ver enum FuncaoPatrimonial. Nulo = "sem função
  /// definida", o estado de toda carteira existente até alguém classificar.
  funcaoPatrimonial FuncaoPatrimonial? @map("funcao_patrimonial")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind         WalletKind   @relation(fields: [kindCode], references: [code])
  institution  Institution? @relation(fields: [institutionId], references: [id])
  linkedWallet Wallet?      @relation("WalletLink", fields: [linkedWalletId], references: [id])
  linkedFrom   Wallet[]     @relation("WalletLink")
  ownerPerson  Person?      @relation("WalletOwner", fields: [ownerPersonId], references: [id])
  entries      Entry[]
  goals        Goal[]
  creditCard   CreditCard?
  investments  Investment[]
  reconciliations BalanceReconciliation[]

  @@unique([workspaceId, slug])
  @@map("wallets")
}

/// Dados exclusivos de cartão de crédito (imagem, anuidade, programa de
/// pontos/milhas) — ligado 1:1 a uma Wallet de kindCode=CARTAO_CREDITO.
/// Os campos de fatura em si (closingDay/dueDay/creditLimit/institutionId)
/// continuam em Wallet, já usados por lib/finance/card.ts, importação de
/// OFX e o lançamento rápido — aqui só o que não faz sentido para as outras
/// 8 kinds de carteira (conta bancária, caixinha, voucher etc.).
model CreditCard {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId              String   @unique @map("wallet_id") @db.Uuid
  imageUrl              String?  @map("image_url")
  annualFee             Decimal? @map("annual_fee") @db.Decimal(14, 2)
  /// Texto livre — ex.: "isento gastando R$ 1.500/mês". Só informativo, não entra em cálculo.
  annualFeeWaiverNote   String?  @map("annual_fee_waiver_note")
  /// Ex.: "Livelo", "Smiles", "Cashback" — só rótulo, não afeta o cálculo de benefício.
  rewardsProgramName    String?  @map("rewards_program_name")
  pointsPerRealSpent    Decimal? @map("points_per_real_spent") @db.Decimal(10, 4)
  /// Quanto vale, em R$, cada ponto/milha no resgate — estimado pelo usuário.
  pointValueEstimateBRL Decimal? @map("point_value_estimate_brl") @db.Decimal(10, 4)
  createdAt             DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("credit_cards")
}

/// §13.6 da Metodologia PROSPECTA v5.0 (ARQUITETURA-METODO-PROSPECTAR.md
/// §5.6, Etapa 2) — captura periódica e leve de "quanto essa carteira
/// realmente tem", pra comparar contra o saldo calculado
/// (lib/finance/balance.ts::walletBalance). Não é conciliação bancária de
/// verdade (isso seria Open Finance, §5.9, fora de escopo) — é o cliente
/// confirmando de próprio punho, mesmo espírito de conferência manual de
/// extrato. Alimenta o componente "Conciliação" do Índice de Consistência
/// (lib/method/consistency.ts) — carteira nunca conferida entra como "não
/// avaliada", nunca como falha.
model BalanceReconciliation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  walletId        String   @map("wallet_id") @db.Uuid
  declaredBalance Decimal  @map("declared_balance") @db.Decimal(14, 2)
  /// Saldo calculado (lib/finance/balance.ts) no exato momento da checagem —
  /// travado aqui, não recalculado depois, pra registro histórico ficar
  /// estável mesmo se lançamentos passados mudarem.
  systemBalance   Decimal  @map("system_balance") @db.Decimal(14, 2)
  checkedBy       String   @map("checked_by") @db.Uuid
  checkedAt       DateTime @default(now()) @map("checked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([workspaceId, walletId, checkedAt])
  @@map("balance_reconciliations")
}

// ---------------------------------------------------------------------------
// Responsáveis (§2, §9) — por workspace.
// ---------------------------------------------------------------------------

/// §19 da especificação PROSPECTA-MCRF — regime de trabalho. Determina quais
/// proteções trabalhistas/previdenciárias são aplicáveis (§25): militar e
/// servidor estatutário NÃO têm FGTS, seguro-desemprego nem verbas rescisórias
/// de CLT, e presumir isso seria erro material no stress test.
enum RegimeTrabalho {
  SERVIDOR_EFETIVO
  MILITAR
  EMPREGADO_PUBLICO
  CLT
  CARGO_COMISSIONADO
  TEMPORARIO
  PROFISSIONAL_LIBERAL
  AUTONOMO
  EMPRESARIO
  MEI
  INFORMAL
  APOSENTADO
  PENSIONISTA
  DESEMPREGADO
  OUTRO
}

/// §21.1–21.4 — quão real é a capacidade de gerar renda substituta. A ordem é
/// decrescente em evidência prática: só ATIVA e ADORMECIDA entram como renda
/// resiliente nos cenários; POSSIBILIDADE_TEORICA nunca entra (§21.4).
enum SegundaAtividadeNivel {
  /// Já existe e pode ser comprovada.
  RENDA_SECUNDARIA_ATIVA
  /// Existiu recentemente, hoje parada.
  RENDA_SECUNDARIA_ADORMECIDA
  /// Há formação/capacidade, pouca evidência prática.
  CAPACIDADE_POTENCIAL
  /// Apenas hipótese — não é renda resiliente.
  POSSIBILIDADE_TEORICA
}

model Person {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  slug        String
  isShared    Boolean  @default(false) @map("is_shared")

  /// --- Perfil de risco (Etapa 9-A.1, PROSPECTA-MCRF §19/§21) ---
  /// Todos opcionais: `Person` existe desde a Fase 0 como "responsável" de
  /// lançamento e continua funcionando sem nada disto preenchido. Estender aqui
  /// em vez de criar uma entidade "membro da família" é deliberado — §59 proíbe
  /// nova fonte de verdade para dado que já existe, e titularidade econômica já
  /// mora em `Person` (ver ownedWallets/ownedInvestments/ownedAssets).
  regimeTrabalho RegimeTrabalho? @map("regime_trabalho")
  /// Profissão declarada, texto livre. `cboCode` é a normalização opcional —
  /// §19 pede a estrutura pronta para CBO sem exigir a integração agora.
  occupation     String?         @map("occupation")
  cboCode        String?         @map("cbo_code")
  cargo          String?
  setor          String?
  /// Meses no vínculo atual e de experiência total — insumos do IPP (§20).
  /// Separados de propósito: tempo de casa mede estabilidade, experiência total
  /// mede portabilidade, e confundir os dois é justamente o erro que §23 aponta.
  tenureCurrentMonths   Int? @map("tenure_current_months")
  experienceTotalMonths Int? @map("experience_total_months")

  /// §21 — capacidade de renda substituta. `segundaAtividade` é a descrição;
  /// o nível é o que o motor consome.
  segundaAtividade      String?                @map("segunda_atividade")
  segundaAtividadeNivel SegundaAtividadeNivel? @map("segunda_atividade_nivel")

  /// §7.2 — dependentes não geram renda e ampliam a despesa essencial que
  /// precisa continuar sendo paga no cenário adverso. Nunca inferido: uma
  /// `Person` sem lançamento de receita pode ser só um responsável pouco usado.
  isDependent Boolean @default(false) @map("is_dependent")

  createdAt   DateTime @default(now()) @map("created_at")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries         Entry[]
  incomeSources   IncomeSource[]
  insurancePolicies InsurancePolicy[]
  benefitEntitlements BenefitEntitlement[]
  /// Etapa 1 (2026-08-15) — titularidade econômica de carteiras/investimentos/
  /// bens dentro da unidade financeira. Ver Wallet/Investment/Asset.ownerPersonId.
  ownedWallets     Wallet[]     @relation("WalletOwner")
  ownedInvestments Investment[] @relation("InvestmentOwner")
  ownedAssets      Asset[]      @relation("AssetOwner")
  shockEvents      ShockEvent[]

  @@unique([workspaceId, slug])
  @@map("people")
}

/// §14 da especificação PROSPECTA-MCRF — natureza da fonte de renda. Define
/// previsibilidade e o que acontece com ela em cada cenário: salário some na
/// demissão, aluguel não; aposentadoria não some em cenário nenhum.
enum IncomeSourceKind {
  SALARIO
  PRO_LABORE
  AUTONOMO
  ALUGUEL
  APOSENTADORIA
  PENSAO
  BENEFICIO
  RENDA_PASSIVA
  BICO
  OUTRO
}

/// §14 — uma fonte de renda de uma pessoa da unidade financeira.
///
/// **Não duplica o lançamento de receita.** O `Entry` de natureza RECEITA
/// continua sendo a única fonte de verdade sobre quanto entrou e quando —
/// mediana, volatilidade e sazonalidade (§15) são medidas a partir dele, nunca
/// declaradas aqui. Esta tabela guarda só o que o extrato **não** revela: que
/// tipo de vínculo é, de quem depende, e se pode ser interrompida. `categoryId`
/// aponta para a categoria RECEITA já seedada, para o motor casar os `Entry`
/// desta fonte sem inventar taxonomia nova (§59).
model IncomeSource {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  personId    String           @map("person_id") @db.Uuid
  name        String
  kind        IncomeSourceKind
  /// Categoria RECEITA correspondente — opcional: nem toda fonte tem uma
  /// categoria própria, e forçar o vínculo criaria cadastro obrigatório sem ganho.
  categoryId  String?          @map("category_id") @db.Uuid

  /// §18 — o nome do empregador/pagador é o que permite **inferir** correlação
  /// de renda familiar em vez de perguntar: duas fontes de pessoas diferentes
  /// com o mesmo pagador não são duas rendas independentes. Texto livre e
  /// opcional; a comparação é por normalização, nunca por FK (não é entidade).
  employerName String? @map("employer_name")
  setor        String?

  /// §14 — o que torna a fonte frágil. Nulo = não informado, nunca "false":
  /// ausência de dado não pode virar afirmação de segurança (§8).
  dependeDeEmpregador     Boolean? @map("depende_de_empregador")
  dependeDePoucosClientes Boolean? @map("depende_de_poucos_clientes")

  /// Marca a fonte cuja interrupção é simulada no Cenário B (§31). Só uma por
  /// pessoa faz sentido, mas não é travado no banco — quem valida é a ação.
  isPrincipal Boolean @default(false) @map("is_principal")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([workspaceId, personId])
  @@map("income_sources")
}

/// §26 da especificação PROSPECTA-MCRF — tipos de seguro relevantes para o
/// motor de risco.
enum InsuranceKind {
  VIDA
  INCAPACIDADE
  PROTECAO_RENDA
  SAUDE
  ODONTOLOGICO
  AUTOMOVEL
  RESIDENCIAL
  PRESTAMISTA
  EMPRESARIAL
  OUTRO
}

/// §26 — uma apólice contratada. O que o motor consome de verdade são as
/// coberturas (`InsuranceCoverage`); a apólice é o agrupador comercial.
model InsurancePolicy {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  /// Quem está segurado. Nulo = protege a unidade financeira toda (ex.: seguro
  /// residencial), não uma pessoa específica.
  personId    String?       @map("person_id") @db.Uuid
  kind        InsuranceKind
  name        String
  insurerName String?       @map("insurer_name")
  /// Prêmio mensal equivalente — o custo da proteção, que é despesa essencial
  /// rígida no CEMA. Opcional: a apólice serve ao motor mesmo sem ele.
  premiumMonthly Decimal?   @map("premium_monthly") @db.Decimal(14, 2)
  startsAt    DateTime?     @map("starts_at") @db.Date
  endsAt      DateTime?     @map("ends_at") @db.Date
  isActive    Boolean       @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  coverages InsuranceCoverage[]

  @@index([workspaceId, isActive])
  @@map("insurance_policies")
}

/// §26 — o que a apólice de fato cobre, com os três números que decidem se ela
/// reduz ou não a necessidade de liquidez:
///
/// - **franquia** (`deductible`): sai do bolso mesmo com seguro;
/// - **carência** (`waitingPeriodDays`): antes dela, não há cobertura nenhuma;
/// - **prazo de indenização** (`payoutDelayDays`): o dinheiro chega DEPOIS.
///
/// O terceiro é o mais esquecido e o mais importante para §33: uma indenização
/// que só chega no terceiro mês **não reduz** a necessidade de caixa do
/// primeiro. Sem este campo o motor daria uma reserva confortável no papel e
/// insuficiente na vida real.
model InsuranceCoverage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId String @map("policy_id") @db.Uuid
  /// Risco coberto em texto livre ("colisão", "morte", "invalidez por acidente").
  riskCovered String @map("risk_covered")
  /// Capital segurado ou limite máximo da cobertura.
  capitalInsured    Decimal? @map("capital_insured") @db.Decimal(14, 2)
  deductible        Decimal? @map("deductible") @db.Decimal(14, 2)
  waitingPeriodDays Int?     @map("waiting_period_days")
  payoutDelayDays   Int?     @map("payout_delay_days")
  exclusions        String?

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("insurance_coverages")
}

/// §25 — proteções trabalhistas e previdenciárias. Quais existem depende do
/// regime (`Person.regimeTrabalho`): militar e servidor estatutário NÃO têm
/// FGTS, seguro-desemprego nem verbas rescisórias de CLT, e presumir isso seria
/// erro material no stress test (§23).
enum BenefitKind {
  FGTS
  SEGURO_DESEMPREGO
  VERBAS_RESCISORIAS
  AUXILIO_DOENCA
  APOSENTADORIA_INVALIDEZ
  PENSAO_MORTE
  LICENCA_ESTATUTARIA
  BENEFICIO_EMPREGADOR
  OUTRO
}

/// §25 — um benefício ao qual a pessoa **pode** ter direito.
///
/// "Ter direito" não basta: o motor precisa de elegibilidade, valor, duração e
/// **quando o dinheiro chega**. `isEligible` é nulo enquanto não confirmado —
/// nunca `false` por omissão, porque ausência de informação não pode virar
/// afirmação de que a proteção não existe (§8).
model BenefitEntitlement {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  personId    String      @map("person_id") @db.Uuid
  kind        BenefitKind
  isEligible  Boolean?    @map("is_eligible")
  /// Valor mensal estimado (ou parcela única, conforme o benefício).
  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(14, 2)
  durationMonths  Int?     @map("duration_months")
  /// Dias entre o evento e a disponibilidade real do recurso. Mesmo papel do
  /// `payoutDelayDays` do seguro: o benefício só entra no fluxo do mês em que
  /// razoavelmente estará na conta.
  availableAfterDays Int?  @map("available_after_days")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([workspaceId, personId])
  @@map("benefit_entitlements")
}

// ---------------------------------------------------------------------------
// Referências de lançamento (§6.3, §8.5) — global, usadas a partir da
// Fase 1 quando `entry` existir, mas carregadas por seed já na Fase 0.
// ---------------------------------------------------------------------------

model Status {
  code            String  @id
  labelPt         String  @map("label_pt")
  countsAsSettled Boolean @map("counts_as_settled")

  entries Entry[]

  @@map("statuses")
}

model RecurrenceKind {
  code           String  @id
  legacyLabel    String? @map("legacy_label")
  intervalMonths Int     @map("interval_months")

  entries Entry[]

  @@map("recurrence_kinds")
}

// ---------------------------------------------------------------------------
// Lançamentos (§8) — Conversa 3.
// ---------------------------------------------------------------------------

/// §8.4 — um compromisso financeiro que atravessa meses (parcelas de um
/// financiamento, ocorrências de uma assinatura). group_id é atribuído
/// automaticamente na criação, nunca digitado.
model EntryGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@map("entry_groups")
}

/// §8.1 — a entidade central do sistema.
model Entry {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Preservado para uma eventual migração histórica futura — o importador
  /// atual (§18) não popula este campo, pois não há migração do legado (§18).
  legacyId    Int?    @map("legacy_id")
  workspaceId String  @map("workspace_id") @db.Uuid
  groupId     String? @map("group_id") @db.Uuid

  /// Compra — fato gerador.
  transactionDate DateTime  @map("transaction_date") @db.Date
  /// Vence — liquidação.
  dueDate         DateTime  @map("due_date") @db.Date
  /// [MELHORIA] data efetiva da liquidação.
  settledAt       DateTime? @map("settled_at") @db.Date

  walletId      String      @map("wallet_id") @db.Uuid
  nature        EntryNature
  categoryId    String      @map("category_id") @db.Uuid
  subcategoryId String?     @map("subcategory_id") @db.Uuid
  description   String
  responsibleId String      @map("responsible_id") @db.Uuid
  /// Com sinal — despesa negativa, receita positiva (§8.3).
  amount        Decimal     @db.Decimal(14, 2)

  recurrenceCode        String  @map("recurrence_code")
  installmentNumber     Int?    @map("installment_number")
  installmentTotal      Int?    @map("installment_total")
  /// §13 "Incidentes" — marca que um humano revisou e confirmou que esta linha (ver
  /// lib/finance/incidents.ts::isEntryIncident — parcela órfã sem groupId, ou
  /// importação de OFX sem histórico de categoria) está correta como está, mesmo
  /// sinalizada automaticamente. Nulo enquanto não revisada — aparece em
  /// Compromissos → Incidentes até ser confirmada ou editada.
  incidentAcknowledgedAt DateTime? @map("incident_acknowledged_at")
  /// §18 — preenchido pela importação de OFX quando a categoria não teve nenhum
  /// histórico de descrição igual no workspace e caiu na categoria padrão escolhida
  /// pelo usuário (nunca bloqueia a linha, mas precisa de revisão manual). Nulo para
  /// qualquer lançamento manual ou importado por CSV. Junto com `installmentTotal
  /// >= 2 sem groupId`, é a segunda condição que faz uma linha virar "Incidente".
  autoReviewReason String? @map("auto_review_reason")
  /// §6.4 — substituem os marcadores Patrimônio/Previsão da recorrência da planilha.
  isPatrimonio          Boolean @default(false) @map("is_patrimonio")
  isProjecao            Boolean @default(false) @map("is_projecao")
  /// §6.4 — preserva o rótulo original da planilha para rastreabilidade.
  legacyRecurrenceLabel String? @map("legacy_recurrence_label")

  statusCode String @map("status_code")

  note String?  @map("note")
  /// Substitui a coluna "Organização" da planilha — array de tags livres (§8.1).
  tags String[] @default([])

  /// Quando preenchido, manda sobre a regra automática fixa×variável (§11.7).
  isFixedOverride Boolean? @map("is_fixed_override")

  /// Método PROSPECTAR §13.3 (ARQUITETURA-METODO-PROSPECTAR.md §5.1, Etapa 1) —
  /// mesmo espírito de isFixedOverride: quando preenchido, manda sobre o
  /// macroBloco herdado de subcategory nesta linha específica (ex.: combustível
  /// que é essencial pra um lançamento mas estilo de vida noutro).
  macroBlocoOverride MacroBloco? @map("macro_bloco_override")

  /// Liga as duas linhas de uma transferência (§10 R5). Nulo para lançamentos normais.
  transferId String? @map("transfer_id") @db.Uuid

  /// Preenchido só quando o lançamento nasceu de uma importação de CSV (§18.1).
  importBatchId String? @map("import_batch_id") @db.Uuid

  /// Descrição original da fatura, exatamente como o banco imprimiu — nunca
  /// editável pelo usuário. Só preenchida pela importação de fatura em PDF
  /// (nula pra CSV/OFX/lançamento manual). `description` continua sendo o
  /// texto editável, exibido/usado no resto do sistema — este campo existe só
  /// pra servir de chave estável pra `DescriptionRule` reconhecer a mesma
  /// compra em faturas futuras, mesmo depois do usuário personalizar a
  /// descrição/categoria/subcategoria.
  importedDescription String? @map("imported_description")

  /// Liga esta entry ao bem que ela documenta (Fase 3, §7.4 "Bens*") — aquisição
  /// ou valorização/desvalorização. Nulo pra qualquer lançamento normal. Mesmo
  /// padrão de `transferId`/`importBatchId`: FK direta, não `EntryGroup`.
  assetId String? @map("asset_id") @db.Uuid

  /// Liga esta entry a uma posição de investimento (menu "Investimentos") —
  /// aporte/ganho/perda/dividendo/juro/retirada (nature=INVESTIMENTO, na carteira
  /// da posição) ou renda real (nature=RECEITA, numa carteira diferente, onde o
  /// aluguel/distribuição de lucro realmente cai). Nulo pra qualquer lançamento
  /// normal. Sem cascade de propósito — diferente de Bens, aqui pode haver renda
  /// REAL numa carteira de verdade; excluir a posição nunca deve apagar dinheiro
  /// que realmente entrou em algum lugar (por isso excluir só é permitido sem
  /// nenhuma entry vinculada — ver `lib/entries/investment.ts::deleteInvestment`).
  investmentId String? @map("investment_id") @db.Uuid

  /// ID do evento correspondente no Google Agenda do workspace (integração,
  /// ver GoogleCalendarConnection), preenchido só enquanto o compromisso está
  /// A_PAGAR/A_RECEBER e o workspace tem a integração conectada. Some (volta a
  /// nulo) quando o lançamento é liquidado ou excluído — regra confirmada com
  /// o usuário: evento pago some da agenda, não fica marcado como concluído.
  googleEventId String? @map("google_event_id")

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       EntryGroup?    @relation(fields: [groupId], references: [id])
  wallet      Wallet         @relation(fields: [walletId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?   @relation(fields: [subcategoryId], references: [id])
  responsible Person         @relation(fields: [responsibleId], references: [id])
  recurrence  RecurrenceKind @relation(fields: [recurrenceCode], references: [code])
  status      Status         @relation(fields: [statusCode], references: [code])
  importBatch ImportBatch?   @relation(fields: [importBatchId], references: [id])
  /// Cascade de propósito (diferente de wallet/category, que nunca cascateiam):
  /// as entries ligadas a um bem só existem pra documentar o valor dele — sem
  /// significado independente. Excluir o bem por engano de cadastro deve
  /// desfazer tudo, não deixar entry órfã.
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  investment  Investment?    @relation(fields: [investmentId], references: [id])

  @@index([workspaceId, dueDate])
  @@index([workspaceId, walletId])
  @@index([groupId])
  @@index([investmentId])
  @@index([transferId])
  @@index([assetId])
  @@map("entries")
}

/// §18.1 — um lote importado. Revertível com 1 clique enquanto nenhum dos
/// lançamentos do lote tiver sido editado depois (checado em código:
/// updated_at ainda igual a created_at).
model ImportBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  originalFilename String    @map("original_filename")
  importedCount    Int       @map("imported_count")
  errorCount       Int       @map("error_count")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  revertedAt       DateTime? @map("reverted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@map("import_batches")
}

/// Regra "aprendida" ao editar um lançamento importado de fatura de cartão em
/// Cartões de Crédito: da próxima vez que a mesma `Entry.importedDescription`
/// (normalizada) aparecer em QUALQUER fatura importada do workspace — não só
/// no mesmo cartão —, a importação de PDF aplica a descrição/categoria/
/// subcategoria daqui em vez da sugestão por histórico de frequência. Só vale
/// para as próximas importações; não reescreve lançamentos já existentes.
model DescriptionRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid

  /// `Entry.importedDescription` normalizada (trim + minúsculo) — mesma
  /// normalização que `suggestCategoriesByDescription` já usa pra descrição.
  matchDescription  String @map("match_description")
  customDescription String @map("custom_description")

  categoryId    String  @map("category_id") @db.Uuid
  subcategoryId String? @map("subcategory_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@unique([workspaceId, matchDescription])
  @@map("description_rules")
}

/// §18.2 — "exportação é a principal via de vazamento de dados financeiros":
/// registro enxuto de quem exportou o quê, não um sistema de auditoria genérico.
model ExportLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  format      String
  /// resumo legível dos filtros ativos no momento da exportação (período, carteira, etc.)
  filters     String?
  rowCount    Int      @map("row_count")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("export_logs")
}

// ---------------------------------------------------------------------------
// Orçamento (§13, Fase 2 — aba ORÇ da planilha original) — valor planejado por
// categoria de DESPESA/mês, comparado contra o realizado já calculado por
// lib/finance/rankings.ts::categoryMonthlyBreakdown. Tabela nova, só aditiva.
// ---------------------------------------------------------------------------

model Budget {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  year          Int
  month         Int // 1-12
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id])

  @@unique([workspaceId, categoryId, year, month])
  @@map("budgets")
}

// ---------------------------------------------------------------------------
// Patrimônio e Metas (Fase 3, §5/§7.4) — Dívidas (`debt`) fica de fora desta
// etapa, adiado a pedido do usuário até haver mais clareza de uso real.
// ---------------------------------------------------------------------------

/// Um bem do patrimônio (§7.4 "Bens*"). O valor atual nunca é armazenado —
/// é sempre a soma das `Entry` ligadas via `Entry.assetId` (aquisição +
/// valorizações/desvalorizações), mesmo princípio de "campo calculado nunca
/// persiste" já usado em todo o resto do sistema (§8.1).
model Asset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Uma das categorias "Bens*" já seedadas em OUTRO — nenhuma categoria nova.
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  /// §20 — nunca exclui (preserva histórico de lançamentos ligados), só arquiva.
  isActive    Boolean  @default(true) @map("is_active")
  /// Etapa 1 (2026-08-15) — ver Wallet.ownerPersonId, mesmo padrão.
  ownerPersonId String? @map("owner_person_id") @db.Uuid
  /// Etapa 7 (2026-08-15) — ver Wallet.funcaoPatrimonial, mesmo padrão.
  funcaoPatrimonial FuncaoPatrimonial? @map("funcao_patrimonial")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id])
  ownerPerson Person?   @relation("AssetOwner", fields: [ownerPersonId], references: [id])
  entries     Entry[]

  @@map("assets")
}

/// Uma meta (§7.4 "Sonhos_Metas") — generaliza o que hoje só existe hardcoded
/// pra Reserva de Emergência (`lib/finance/reserve.ts`): valor-alvo ligado a
/// uma caixinha (`Wallet.kind = CONTA_CAIXA`) já existente. Guardar dinheiro
/// continua sendo uma transferência normal (§10 R5) — nenhuma mudança em como
/// o saldo da caixinha é calculado.
model Goal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  walletId       String    @map("wallet_id") @db.Uuid
  name           String
  targetAmount   Decimal   @map("target_amount") @db.Decimal(14, 2)
  targetDate     DateTime? @map("target_date") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  /// Aparece na seção "Metas" do Painel — preferência de exibição, não dado
  /// da meta em si (por isso fica fora da trava de edição do card, clicável
  /// direto, mesmo espírito do botão Arquivar).
  pinnedToPainel Boolean   @default(false) @map("pinned_to_painel")
  createdAt      DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    Wallet    @relation(fields: [walletId], references: [id])

  @@map("goals")
}

/// Classe de investimento (renda fixa, renda variável, imóveis, veículos, participação
/// societária...) — referência extensível, nunca enum (mesmo padrão de `WalletKind`/
/// `RecurrenceKind`/`Status`), seedada de `seeds/seed_investment_classes.csv`. Dirige
/// quais campos o formulário de "Novo investimento" mostra em `Investment.details`;
/// não confundir com `Category` do `Entry`, que classifica o EVENTO (Aporte, Ganho de
/// Capital, Dividendo...) — são duas dimensões independentes.
model InvestmentClass {
  code       String @id
  labelPt    String
  /// Agrupador de exibição: "Investimentos Financeiros" / "Ativos Reais" /
  /// "Participações em Empresas" / "Previdência" / "Outros".
  groupLabel String @map("group_label")
  sortOrder  Int    @map("sort_order")

  investments Investment[]

  @@map("investment_classes")
}

/// Uma posição individual de investimento (§ menu "Investimentos", pedido do
/// usuário 2026-08-10) — mesmo espírito de `Asset` pra Bens: um lançamento de
/// aporte/ganho/perda/renda em `Entry` já aparece em Lançamentos de forma
/// sintética; esta ficha é o "analítico" (posição, rentabilidade, alocação).
/// Diferente de Bens, mora numa carteira DE VERDADE (kindCode=CONTA_INVESTIMENTO —
/// a corretora, ou o próprio imóvel/veículo/empresa quando não há corretora), não
/// numa pseudo-conta — o dinheiro aportado é real, só o "quanto vale hoje" é
/// documentado por atualização manual (mesmo mecanismo de Bens).
model Investment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  walletId    String   @map("wallet_id") @db.Uuid
  classCode   String   @map("class_code")
  name        String
  /// {instrumentType, + campos específicos da classe: ticker/quantidade/preço médio,
  /// indexador/taxa/vencimento, endereço/aluguel esperado, placa/km, percentual/razão
  /// social...} — ver union type `InvestmentDetails` em `lib/finance/investment.ts`.
  details     Json
  /// Arquivar é o caminho normal pra "aposentar" uma posição com histórico —
  /// excluir de verdade só é permitido sem nenhum `Entry` vinculado (mesma regra
  /// de `Wallet`/`CreditCard`/`Subcategory`).
  isActive    Boolean  @default(true) @map("is_active")
  /// Etapa 1 (2026-08-15) — ver Wallet.ownerPersonId, mesmo padrão.
  ownerPersonId String? @map("owner_person_id") @db.Uuid
  /// Etapa 7 (2026-08-15) — ver Wallet.funcaoPatrimonial, mesmo padrão.
  funcaoPatrimonial FuncaoPatrimonial? @map("funcao_patrimonial")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  class       InvestmentClass @relation(fields: [classCode], references: [code])
  ownerPerson Person?         @relation("InvestmentOwner", fields: [ownerPersonId], references: [id])
  entries     Entry[]

  @@map("investments")
}

/// §13/§18 — vínculo de um workspace com o Google Agenda do titular (um sentido
/// só: sistema → Google). OAuth próprio, separado do "Entrar com Google" do
/// login (esse passa pelo Supabase Auth e só pede escopo de identidade) —
/// aqui é preciso o escopo `calendar.events` e um refresh token de longa
/// duração, guardado criptografado (nunca em texto puro, ver
/// lib/security/crypto.ts). Um vínculo por workspace; os eventos vivem num
/// calendário DEDICADO ("PROSPECTA Finance"), não na agenda pessoal do
/// cliente — desconectar é 1 chamada (apaga o calendário inteiro) em vez de
/// apagar evento por evento.
model GoogleCalendarConnection {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @unique @map("workspace_id") @db.Uuid
  googleAccountEmail   String    @map("google_account_email")
  /// ID do calendário dedicado criado na conta do cliente no momento da conexão.
  googleCalendarId     String    @map("google_calendar_id")
  /// Criptografados em repouso (AES-256-GCM, lib/security/crypto.ts) — nunca gravados em texto puro.
  accessToken          String    @map("access_token")
  refreshToken         String    @map("refresh_token")
  accessTokenExpiresAt DateTime  @map("access_token_expires_at")
  connectedByProfileId String    @map("connected_by_profile_id") @db.Uuid
  connectedAt          DateTime  @default(now()) @map("connected_at")
  /// Preenchido ao desconectar — a linha fica para auditoria (quem conectou/
  /// desconectou quando), mesmo espírito de Membership.status/revokedAt.
  revokedAt            DateTime? @map("revoked_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy Profile   @relation(fields: [connectedByProfileId], references: [id])

  @@map("google_calendar_connections")
}

/// §8 da Metodologia PROSPECTA v5.0 (ARQUITETURA-METODO-PROSPECTAR.md §5.3,
/// Etapa 5, 2026-08-15) — foto do Painel de Saúde Financeira no tempo. Uma
/// linha por cálculo (hoje sempre manual, via botão "Salvar no histórico";
/// automático/mensal fica para quando houver infraestrutura de job) ou por
/// revisão do consultor (ainda não existe, Etapa 8). Sustenta o "comparativo
/// início x fim" (§8.1) sem recalcular o passado — indicadores antigos
/// continuam os mesmos mesmo que a fórmula mude depois.
model HealthSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  snapshotDate DateTime @map("snapshot_date") @db.Date
  /// {organizacao, endividamento, liquidez, protecao, construcao, longevidade?, continuidade?}
  /// cada um {faixa: "critico"|"fragil"|"em_construcao"|"saudavel"|"consolidado"|null, valor: number|null}
  /// — indicador ausente por nível ou por dependência futura (Longevidade/
  /// Continuidade, Etapas 13/15) fica null, nunca faixa ruim (§8.3).
  indicators   Json
  origin       String   @default("AUTO") // "AUTO" | "REVISADO"
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, snapshotDate])
  @@map("health_snapshots")
}

/// §13.8 da Metodologia PROSPECTA v5.0 (ARQUITETURA-METODO-PROSPECTAR.md §5.5,
/// Etapa 6, 2026-08-15) — motor de regras do Max. Cada gatilho observa uma
/// condição sobre dado já lançado e, quando verdadeira, produz uma
/// `Notification` — nunca cria, edita ou liquida um `Entry`, nunca transfere,
/// nunca cancela nada externamente. Decisão validada por benchmark (Pierre,
/// CloudWalk): mesmo um concorrente com acesso transacional completo via Open
/// Finance escolhe só alertar, nunca agir sozinho.
enum AutomationTrigger {
  LIMIAR_CATEGORIA
  VENCIMENTO_PROXIMO
  VARIACAO_RECORRENCIA
  META_FORA_DA_TRAJETORIA
  INCIDENTE_ACUMULADO
}

model AutomationRule {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  trigger     AutomationTrigger
  /// Parâmetros do gatilho — forma por trigger documentada em
  /// lib/method/automation-engine.ts (ex.: {categoryId, thresholdAmount} / {daysBefore}).
  condition   Json
  isActive    Boolean           @default(true) @map("is_active")
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

/// Histórico de perguntas ao assistente — auditoria (P9; mesmo espírito do
/// LGPD Art. 20 já aplicado ao PSF). `answerQuery` grava a consulta
/// estruturada que de fato gerou a resposta — cada resposta é reproduzível,
/// nunca só um texto solto sem lastro.
model AiInteraction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  askedBy     String   @map("asked_by") @db.Uuid
  question    String
  answerQuery Json?    @map("answer_query")
  answerText  String   @map("answer_text")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_interactions")
}

/// Rastro de execução do cron de automações (ARQUITETURA-METODO-PROSPECTAR.md
/// §5.5.1). Existe por causa de um episódio concreto: no Registro Nº 087 não
/// havia como distinguir **"rodou e não havia nada a alertar"** de **"não
/// rodou"**, e o diagnóstico só foi possível porque a condição de uma regra era
/// permanente — com regra de condição transitória, a pergunta "rodou?" não
/// teria resposta.
///
/// A linha nasce no **início** da execução e é fechada no fim. Uma linha com
/// `finishedAt` nulo e antiga é justamente o sinal mais valioso: começou e
/// morreu no meio, que é a falha que não deixa rastro em lugar nenhum.
///
/// Não tem `workspaceId`: uma execução atravessa todos os workspaces. Os
/// contadores são o resumo; o efeito por workspace continua sendo a
/// `Notification`.
model AutomationRun {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt           DateTime  @default(now()) @map("started_at")
  /// Nulo enquanto corre — e permanentemente nulo se a execução morreu no meio.
  finishedAt          DateTime? @map("finished_at")
  workspacesEvaluated Int       @default(0) @map("workspaces_evaluated")
  rulesEvaluated      Int       @default(0) @map("rules_evaluated")
  notified            Int       @default(0)
  /// Mensagem do erro quando a execução falhou. Nulo em execução bem-sucedida.
  error               String?
  /// "CRON" (Vercel) | "MANUAL" (admin disparou pela tela).
  source              String    @default("CRON")

  @@index([startedAt])
  @@map("automation_runs")
}

/// §12.2 da Metodologia v5.0 — o diagnóstico em três camadas. Cada instrumento
/// coleta um tipo diferente de dado, em momento diferente, e é essa separação
/// que neutraliza os dois vieses que a metodologia nomeia: "no formulário ele
/// omite o que é vergonhoso; na entrevista ele erra o que é numérico".
///
/// **B é de uso interno exclusivo** (§12.5: "nunca entregue ao cliente"): é o
/// roteiro da entrevista, preenchido pelo consultor **depois** da reunião. Por
/// isso `respondedBy` não é sempre o titular — o campo existe justamente para
/// registrar quem de fato respondeu.
enum DiagnosticInstrument {
  A1
  A2
  B
  C
}

/// §12 — respostas dos instrumentos de diagnóstico.
///
/// `answers` é `Json` de propósito: a **redação** de cada pergunta ainda é
/// decisão do dono do produto (Pendências #6–8 da Metodologia v5.0), enquanto
/// os **campos** que cada instrumento coleta estão especificados em §12.3/12.4/
/// 12.6. Guardar resposta em coluna fixa congelaria uma redação que ainda vai
/// mudar; guardar em Json com o catálogo versionado em `lib/method/instruments/`
/// deixa a redação evoluir sem migração e sem perder o que já foi respondido.
///
/// Não há unicidade por (engagement, instrumento): o **C é respondido
/// individualmente e sem companhia** (§12.6), então um mesmo contrato tem uma
/// resposta de C por pessoa. `respondedBy` é quem separa uma da outra.
model DiagnosticResponse {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  engagementId String               @map("engagement_id") @db.Uuid
  instrument   DiagnosticInstrument
  /// Estrutura por instrumento — ver lib/method/instruments/.
  answers      Json
  /// Versão do catálogo que produziu estas respostas. Sem isso, uma resposta
  /// antiga seria relida com perguntas que não são as que foram feitas.
  ///
  /// **Sem `@default` de propósito.** Ter um valor padrão aqui criaria uma
  /// segunda cópia da versão — a do banco e a de `CATALOG_VERSION` — que
  /// divergem silenciosamente na primeira mudança de redação, e o resultado
  /// seria pior que não ter o campo: resposta rotulada com a redação errada.
  /// Quem grava é obrigado a dizer qual redação usou.
  catalogVersion String             @map("catalog_version")
  /// Nulo enquanto o cliente está preenchendo; preenchido ao enviar. É o que
  /// distingue rascunho de resposta entregue, sem uma coluna de status à parte.
  submittedAt  DateTime?            @map("submitted_at")
  respondedBy  String               @map("responded_by") @db.Uuid
  respondedAt  DateTime             @default(now()) @map("responded_at")

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement ConsultingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, instrument])
  @@map("diagnostic_responses")
}
